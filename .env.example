# Copy this file to .env before production deployment and replace every secret.
# The stack also runs without .env using local demo defaults.

MYSQL_ROOT_PASSWORD=change-this-mysql-password
REDIS_PASSWORD=change-this-redis-password

FRONTEND_PORT=3000
ADMIN_PORT=8080
BACKEND_PORT=8088

SITE_URL=http://localhost:3000
UPLOAD_BASE_URL=http://localhost:3000/upload/
UPLOAD_MODE=local
VITE_API_BASE_URL=

# Optional object storage settings. Keep UPLOAD_MODE=local to use the Docker volume.
OSS_URL=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
COS_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET_NAME=

# Required only when email registration or email notifications are enabled.
ALIYUNMAIL_ACCESS_KEY=
ALIYUNMAIL_SECRET_KEY=
ALIYUNMAIL_ENDPOINT=dm.aliyuncs.com
ALIYUNMAIL_REPLY_ADDRESS=
ALIYUNMAIL_ACCOUNT_NAME=

# Optional OAuth settings.
QQ_APP_ID=
WEIBO_APP_ID=
WEIBO_APP_SECRET=
WEIBO_REDIRECT_URL=
GITEE_APP_ID=
GITEE_APP_SECRET=
GITEE_REDIRECT_URL=

JAVA_OPTS=-Xms256m -Xmx512m
TZ=Asia/Shanghai
